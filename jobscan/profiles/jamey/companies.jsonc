      "domain": "healthcare"
    },
    {
      "name": "GiveDirectly",
      "board": "lever",
      "token": "givedirectly", // VERIFY
      "domain": "mission"
    },
    {
      "name": "Christian Care Ministry",
      "board": "greenhouse",
      "token": "christiancareministry", // VERIFY
      "domain": "mission"
    },
    {
      "name": "Epic",
      "board": "greenhouse",
      "token": "epic",
      "active": false,
      "domain": "healthcare",
      "notes": "Madison WI, notoriously onsite. Probably a location reject anyway."
    }
    // --- seed slots: fill to 20-25 target companies ---
  ],

  "feeds": [
    {
      "name": "Christian Tech Jobs",
      "board": "rss",
      "token": "https://christiantechjobs.io/api/rss",
      "domain": "mission"
    }
