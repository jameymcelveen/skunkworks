{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Worker": {
    "WorkerId": "local-1",
    "PollIntervalMs": 1000,
    "ConnectionString": "Host=localhost;Port=5432;Database=cartographer;Username=cartographer;Password=cartographer"
  },
  "Grid": {
    "CellSizeMeters": 10,
    "DatasetVersion": "v1",
    "TtlDays": 90
  },
  "Render": {
    "RenderHtmlPath": "render/render.html",
    "StylePath": "styles/sentinel-style.json",
    "PmtilesUrl": "http://127.0.0.1:8080/data/pmtiles/region.pmtiles",
    "AllowedPmtilesHost": "127.0.0.1",
    "PixelsPerCell": 8,
    "SettleMs": 250,
    "IdleTimeoutMs": 30000
  }
}
