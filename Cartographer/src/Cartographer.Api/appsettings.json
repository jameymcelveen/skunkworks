{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Cartographer": "Host=localhost;Port=5432;Database=cartographer;Username=cartographer;Password=cartographer"
  },
  "Discovery": {
    "CellSizeMeters": 10,
    "DatasetVersion": "v1",
    "MaxBboxCells": 10000,
    "MaxPendingJobsPerGrid": 32,
    "MaxBatchEdge": 64
  },
  "ExpirySweep": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "BatchLimit": 2048,
    "MaxBatchEdge": 64
  }
}
