# Postgres
ConnectionStrings__Cartographer=Host=localhost;Port=5432;Database=cartographer;Username=cartographer;Password=cartographer

# Shared grid identity (must match API + Worker)
Discovery__CellSizeMeters=10
Discovery__DatasetVersion=v1
Grid__CellSizeMeters=10
Grid__DatasetVersion=v1
Grid__TtlDays=90

# Self-hosted pmtiles only (never Mapbox/Google/Bing)
Render__PmtilesUrl=http://127.0.0.1:8080/data/pmtiles/region.pmtiles
Render__AllowedPmtilesHost=127.0.0.1
